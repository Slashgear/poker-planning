{
  "name": "poc-er-planning",
  "version": "3.2.1",
  "type": "module",
  "description": "- React app with tailwind shadcn tanstack - With a simple configuration file to define team composition - Database (SQlite) - Use to estimate task for a team based on fibonacci suite",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx server/index.ts",
    "build": "tsc && vite build",
    "build:analyze": "ANALYZE=true pnpm build",
    "preview": "vite preview",
    "lint": "oxlint src server tests",
    "format": "oxfmt --check src server tests",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "test:load": "k6 run tests/load/scenarios/basic-workflow.js",
    "test:load:basic": "k6 run tests/load/scenarios/basic-workflow.js",
    "test:load:spike": "k6 run tests/load/scenarios/spike-test.js",
    "test:load:stress": "k6 run tests/load/scenarios/stress-test.js",
    "test:load:realistic": "k6 run tests/load/scenarios/realistic-sessions-test.js",
    "test:load:sse": "k6 run tests/load/scenarios/sse-endurance-test.js",
    "test:load:all": "pnpm test:load:basic && pnpm test:load:spike && pnpm test:load:stress",
    "screenshots": "tsx scripts/generate-screenshots.ts"
  },
  "keywords": [],
  "author": "Antoine Caron (@Slashgear)",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@preact/preset-vite": "2.10.5",
    "@tailwindcss/postcss": "4.3.0",
    "@testing-library/preact": "3.2.4",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "24.13.1",
    "autoprefixer": "10.5.0",
    "happy-dom": "20.10.2",
    "husky": "9.1.7",
    "ioredis-mock": "8.13.1",
    "oxfmt": "0.54.0",
    "oxlint": "1.69.0",
    "postcss": "8.5.15",
    "rollup-plugin-visualizer": "7.0.1",
    "sharp": "0.34.5",
    "tailwindcss": "4.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.5",
    "vitest": "4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  },
  "dependencies": {
    "@hono/node-server": "1.19.14",
    "@hono/swagger-ui": "0.6.1",
    "@hono/zod-openapi": "1.4.0",
    "canvas-confetti": "1.9.4",
    "hono": "4.12.24",
    "ioredis": "5.11.1",
    "preact": "10.29.2",
    "preact-iso": "2.12.0",
    "tsx": "4.22.4",
    "zod": "4.4.3"
  }
}
